[Unit]
Description=Site Manager PostgreSQL and upload backup
After=postgresql.service

[Service]
Type=oneshot
User=site-manager
Group=site-manager
EnvironmentFile=/etc/site-manager/site-manager.env
EnvironmentFile=/etc/site-manager/database.env
ExecStart=/usr/bin/bash /srv/site-manager/manager/current/infra/vps/backup-state.sh
UMask=0077
