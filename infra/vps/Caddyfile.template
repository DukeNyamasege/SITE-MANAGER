{
  admin 127.0.0.1:2019
  email __CADDY_EMAIL__
}

__SITE_MANAGER_DOMAIN__ {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8787
}

# Private preview host: same shared nnn release, but preview identity comes from
# the short-lived Site Manager token in the URL rather than the hostname.
__NNN_PREVIEW_DOMAIN__ {
  encode zstd gzip

  handle /api/v2/runtime/* {
    reverse_proxy 127.0.0.1:8787
  }

  handle /uploads/* {
    reverse_proxy 127.0.0.1:8787
  }

  handle {
    root * "/srv/site-manager/nnn/current"
    try_files {path} /index.html
    file_server
  }
}

# Customer hostname snippets generated by Site Manager Step 7 publisher.
# install-host.sh creates a harmless placeholder so this glob always resolves.
import /etc/caddy/sites/*.caddy
