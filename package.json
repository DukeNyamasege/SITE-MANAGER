{
  "name": "site-manager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "db:migrate": "node scripts/migrate.mjs",
    "legacy:audit": "node scripts/import-legacy-nnn.mjs",
