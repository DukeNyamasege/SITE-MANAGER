# Core SITE-MANAGER server-side variables.
# Never expose any of these as VITE_* variables.
GITHUB_TOKEN=
TARGET_REPO=DukeNyamasege/nnn
TARGET_BRANCH=main

# Optional dedicated HMAC key for DNS ownership challenges.
# If omitted, GITHUB_TOKEN is used as the server-side signing secret.
DOMAIN_VERIFICATION_SECRET=

# Netlify custom-domain automation.
NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=
# Example: newtemplate12.netlify.app
NETLIFY_SITE_HOSTNAME=

# Registrar DNS is intentionally manual.
# No VPS, Namecheap API key, fixed IP, or DNS provisioner is required.
