# Core SITE-MANAGER server-side variables.
# Never expose any of these as VITE_* variables.
GITHUB_TOKEN=
TARGET_REPO=DukeNyamasege/nnn
TARGET_BRANCH=main

# Netlify custom-domain automation.
NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=
# Example: newtemplate12.netlify.app
NETLIFY_SITE_HOSTNAME=

# Optional fixed-IP DNS provisioner.
# Run provisioner/server.mjs on a VPS whose public IPv4 is whitelisted in Namecheap.
PROVISIONER_URL=
PROVISIONER_SECRET=

# These variables belong on the fixed-IP VPS, not in the browser.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
# Production: https://api.namecheap.com/xml.response
# Sandbox: https://api.sandbox.namecheap.com/xml.response
NAMECHEAP_API_BASE=https://api.namecheap.com/xml.response
