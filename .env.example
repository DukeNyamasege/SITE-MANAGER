# Browser-visible maintenance switch.
# Production should remain true while the public Netlify site is under development.
# Local Vite development defaults to the V2 workspace when this variable is omitted.
# Final release: set VITE_PUBLIC_MAINTENANCE=false and re-enable netlify.deploy.json.
VITE_PUBLIC_MAINTENANCE=true

# Site Manager V2 VPS application.
APP_URL=http://localhost:5173
PORT=8787
NODE_ENV=development
# Logical host role. Step 14 real staging-edge code will fail closed unless this is exactly `staging`.
SITE_MANAGER_ENVIRONMENT=development

# PostgreSQL is the V2 source of truth for users, sessions, site ownership and website configuration.
# Billing tables are dormant placeholders only; payment activation is intentionally deferred.
DATABASE_URL=postgresql://site_manager:change_me@127.0.0.1:5432/site_manager
DB_POOL_MAX=10
DB_SSL=false

# Authentication.
AUTH_SESSION_TTL_DAYS=30
AUTH_DEV_RETURN_LINKS=true

# Domain-first onboarding for every new V2 website.
# `auto` uses Namecheap when all credentials below are configured; otherwise it falls back to RDAP.
# `namecheap` requires the credentials and the VPS public IP to be whitelisted in the Namecheap API account.
DOMAIN_AVAILABILITY_MODE=auto
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_API_SANDBOX=false

# nnn runtime preview.
# Local development: Rsbuild HTTPS server. Production Step 8: dedicated preview hostname
# served from the same /srv/site-manager/nnn/current release as customer websites.
NNN_PREVIEW_URL=https://localhost:8443
PREVIEW_TTL_MINUTES=60
# Persistent VPS folder for customer logos and future uploaded site assets.
SITE_UPLOAD_DIR=./data/uploads

# Shared VPS website routing.
# Customers without a domain can reserve <site-key>.<PLATFORM_SITE_BASE_DOMAIN>.
PLATFORM_SITE_BASE_DOMAIN=sites.example.com
# DNS is considered routed when the hostname resolves to one of these targets.
# Step 12 also requires at least one of these routing targets before an immutable
# cutover plan may be armed.
VPS_PUBLIC_IPV4=
VPS_PUBLIC_IPV6=
# Optional alternative to direct A/AAAA records, e.g. sites-vps.example.com.
VPS_CNAME_TARGET=

# Step 12 cutover planning. These values do not enable traffic execution.
# Prepared plans expire and must be recreated when evidence changes or the TTL passes.
CUTOVER_PLAN_TTL_MINUTES=120
# This is the intended rollback window after a future execution. The rollback clock
# starts only after a Step 13 canary or Step 14 staging-edge health check succeeds.
CUTOVER_ROLLBACK_WINDOW_MINUTES=30

# Step 13 canary execution rehearsal.
# IMPORTANT: Step 13 supports only `disabled` or `simulate`. There is intentionally
# no live/apply option. Simulation writes isolated route state and never calls Caddy.
CANARY_EXECUTION_MODE=disabled
CANARY_SIMULATION_STATE_DIR=./data/canary-simulation
# Point this to the exact built held nnn artifact participating in the rehearsal.
NNN_CANARY_DIST_DIR=./data/nnn/current
# Exact held nnn Git SHA corresponding to NNN_CANARY_DIST_DIR.
NNN_CANARY_RELEASE=
CANARY_HEALTH_ATTEMPTS=3
CANARY_HEALTH_DELAY_MS=100
# Minimum healthy observation before a simulated canary can be marked passed.
CANARY_MIN_OBSERVATION_SECONDS=300

# Step 14 real staging-host edge rehearsal.
# These settings are intentionally independent from the production customer publisher.
# The adapter enables only when ALL three are true:
# SITE_MANAGER_ENVIRONMENT=staging, STAGING_EDGE_APPROVED=YES, STAGING_EDGE_MODE=staging.
STAGING_EDGE_MODE=disabled
STAGING_EDGE_APPROVED=NO
# A dedicated staging-owned hostname. Never use a customer production hostname here.
STAGING_EDGE_HOSTNAME=staging.example.com
STAGING_EDGE_HTTPS_PORT=443
# `public` uses normal Caddy ACME TLS. `internal` is intended only for isolated CI/local rehearsal.
STAGING_EDGE_TLS_MODE=public
STAGING_EDGE_CADDY_ADMIN=127.0.0.1:2020
STAGING_EDGE_CADDYFILE=./data/staging-edge/Caddyfile
STAGING_EDGE_STATE_DIR=./data/staging-edge
STAGING_CADDY_BIN=/usr/bin/caddy
STAGING_EDGE_CURL_BIN=/usr/bin/curl
# Optional curl --resolve target used by CI/local staging; leave blank on a real staging VPS with DNS.
STAGING_EDGE_RESOLVE_IP=
STAGING_SITE_MANAGER_API_UPSTREAM=http://127.0.0.1:8787
# The exact held nnn build and Git SHA installed on the staging edge.
NNN_STAGING_DIST_DIR=./data/nnn/current
NNN_STAGING_RELEASE=
STAGING_EDGE_REQUEST_TIMEOUT_SECONDS=5
STAGING_EDGE_MONITOR_INTERVAL_MS=5000
STAGING_EDGE_FAILURE_THRESHOLD=3
STAGING_EDGE_MIN_OBSERVATION_SECONDS=300
STAGING_EDGE_TOKEN_TTL_MINUTES=120
# Enables the deliberate 503 health-failure drill only on an isolated staging host.
STAGING_EDGE_DRILL_ALLOW_FAILURE=NO

# Step 15 production eligibility and final approval.
# These values control evidence freshness only. Step 15 never enables production execution.
PRODUCTION_ELIGIBILITY_TTL_MINUTES=60
# A passed Step 14 staging-edge rehearsal older than this must be repeated before approval.
PRODUCTION_ELIGIBILITY_STAGING_MAX_AGE_MINUTES=60

# Step 7/8 shared-runtime publishing engine.
# Keep `plan` during development and initial host installation. Set to `apply` only
# after the shared nnn release, Caddy, DNS and explicit production cutover are ready.
VPS_PUBLISH_MODE=plan
VPS_DEPLOYMENT_STATE_DIR=./data/deployments
# ONE shared nnn build serves every customer hostname. Never point this to a per-site folder.
# Production Step 8 path: /srv/site-manager/nnn/current
NNN_SHARED_DIST_DIR=./data/nnn/current
# Pin this to the exact approved nnn integration source SHA installed in NNN_SHARED_DIST_DIR.
# On the VPS release-nnn.sh writes this through /etc/site-manager/runtime.env.
NNN_RUNTIME_RELEASE=nnn-main-unpinned
# Caddy route snippets generated by Site Manager. Production Step 8 path: /etc/caddy/sites
CADDY_ROUTE_DIR=./data/caddy/sites
CADDY_BIN=/usr/bin/caddy
CADDYFILE=/etc/caddy/Caddyfile
# Same-origin nnn requests to /api/v2/runtime/* and /uploads/* are proxied here.
SITE_MANAGER_API_UPSTREAM=http://127.0.0.1:8787
VPS_HEALTHCHECK_ATTEMPTS=4
VPS_HEALTHCHECK_DELAY_MS=1000

# SMTP for verification and password recovery. Required before production launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Site Manager <no-reply@example.com>

# Legacy GitHub/template integration retained only while current production subsites remain on nnn/main.
# V2 Site Manager runtime/VPS development must NOT publish its integration code to TARGET_BRANCH.
# The new nnn integration is held separately in draft PR #48 until explicit final cutover approval.
GITHUB_TOKEN=
TARGET_REPO=DukeNyamasege/nnn
TARGET_BRANCH=main

# Optional dedicated HMAC key for legacy DNS ownership challenges.
DOMAIN_VERIFICATION_SECRET=

# Legacy Netlify domain automation. Kept only while existing flows are migrated to the VPS platform.
NETLIFY_ACCESS_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_SITE_HOSTNAME=
